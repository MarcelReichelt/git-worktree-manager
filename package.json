{
  "name": "@git-worktree-manager/main",
  "version": "0.9.5",
  "description": "Desktop workspace and CLI for registered git repositories",
  "type": "module",
  "bin": {
    "git-worktree-manager": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js"
  ],
  "scripts": {
    "build": "tsup",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "desktop": "node scripts/ensure-electron-natives.mjs && yarn build:desktop && electron src/desktop/electron-main.mjs",
    "pack:desktop": "node scripts/pack-desktop.mjs",
    "pack:check": "node scripts/check-pack.mjs",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:docker": "docker compose -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e",
    "test:all": "yarn test && yarn test:e2e:docker",
    "link:global": "node scripts/link-global.mjs",
    "unlink:global": "node scripts/unlink-global.mjs",
    "bump": "yarn version patch --immediate",
    "bump:minor": "yarn version minor --immediate",
    "bump:major": "yarn version major --immediate",
    "publish": "yarn build && yarn pack:check && yarn link:global && yarn test:all && yarn npm publish",
    "publish:patch": "yarn bump && yarn publish",
    "publish:minor": "yarn bump:minor && yarn publish",
    "publish:major": "yarn bump:major && yarn publish"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.17.0",
  "dependencies": {
    "@analogjs/vite-plugin-angular": "2.7.5",
    "@angular/build": "22.2.0",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/platform-browser-dynamic": "22.2.1",
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^7.3.2",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "^12.11.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "ink": "^5.2.0",
    "jiti": "^2.4.2",
    "koffi": "^3.3.2",
    "node-pty": "1.1.0",
    "react": "^18.3.1",
    "rxjs": "7.8.2",
    "simple-git": "^4.0.2",
    "zod": "^3.24.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "ink-testing-library": "^4.0.0",
    "jsdom": "26.1.0",
    "tsup": "^8.4.0",
    "typescript": "6.0.3",
    "vite": "6.4.4",
    "vitest": "^4.1.11"
  },
  "resolutions": {
    "tar": "7.5.22",
    "postcss": "8.5.29",
    "http-cache-semantics": "4.3.0",
    "node-gyp/undici": "6.29.0",
    "tsup/esbuild": "0.28.2",
    "global-agent": "link:./scripts/global-agent-stub"
  }
}
